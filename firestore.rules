rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Semana actual, con el mismo cálculo que leaderboard.js:
    // semanas de lunes 00:00 a domingo 23:59, hora del centro de México (UTC-6).
    function currentWeek() {
      return 'w' + string(math.floor((request.time.toMillis() - 367200000) / 604800000));
    }

    // Puntaje plausible según la mecánica del juego:
    //  - Tiempo: cada 10 da 100 × racha (racha ≤ dieces) y cada fusión-10 da 50.
    //  - Contra reloj: el puntaje ES la cantidad de dieces y la partida dura máximo 90 s.
    //  - En ningún modo se pueden hacer más de 2 dieces ni más de 1 fusión-10 por segundo.
    function isValidScore(uid, mode, period) {
      let d = request.resource.data;
      return request.auth != null
        && request.auth.uid == uid
        && mode in ['tiempo', 'reloj']
        && (period == 'all' || period == currentWeek())
        && d.keys().hasOnly(['name', 'score', 'tens', 'bonus10', 'duration', 'updatedAt'])
        && d.keys().hasAll(['name', 'score', 'tens', 'bonus10', 'duration', 'updatedAt'])
        && d.name is string && d.name.size() >= 1 && d.name.size() <= 16
        && d.score is int && d.score > 0 && d.score <= 1000000
        && d.tens is int && d.tens >= 0
        && d.bonus10 is int && d.bonus10 >= 0
        && d.duration is int && d.duration >= 1 && d.duration <= 3600
        && d.tens <= d.duration * 2
        && d.bonus10 <= d.duration
        && d.score <= 50 * d.tens * (d.tens + 1) + 50 * d.bonus10
        && (mode != 'reloj' || (d.score == d.tens && d.duration <= 92))
        && d.updatedAt == request.time;
    }

    // ranks/{modo}/{periodo}/{uid}   periodo = 'all' o 'w<número de semana>'
    match /ranks/{mode}/{period}/{uid} {
      allow read: if mode in ['tiempo', 'reloj'];
      allow create: if isValidScore(uid, mode, period);
      // Solo puede subir (nunca bajar) y máximo una escritura cada 5 segundos.
      allow update: if isValidScore(uid, mode, period)
        && request.resource.data.score >= resource.data.score
        && request.time > resource.data.updatedAt + duration.value(5, 's');
      allow delete: if false;
    }
  }
}
